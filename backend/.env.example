PORT=5000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Real Apigee provider
PROVISIONING_MODE=apigee

# ---------------- only used when PROVISIONING_MODE=apigee ----------------
# Google Cloud project ID that hosts your Apigee X organization
APIGEE_ORG=

# false = create or update resources in Apigee.
APIGEE_DRY_RUN=false

# Credentials: use ONE of these.
#  a) easiest: run `gcloud auth application-default login` (nothing to set here)
#  b) a short-lived token:   gcloud auth print-access-token   (expires after ~1 hour)
APIGEE_ACCESS_TOKEN=
#  c) a service-account key file:  GOOGLE_APPLICATION_CREDENTIALS=C:\keys\apigee-sa.json

# Optional
# Hostname of your environment group; lets the UI print a ready-made test URL
APIGEE_RUNTIME_HOST=
# Service account the deployed proxy runs as (e.g. my-sa@my-project.iam.gserviceaccount.com)
APIGEE_DEPLOY_SERVICE_ACCOUNT=
APIGEE_DEPLOY_TIMEOUT_MS=180000
APIGEE_BUNDLE_DIR=bundles

# PostgreSQL connection string (optional).
# Leave as-is (CHANGE-ME) to run WITHOUT a database: requests are kept in memory
# and lost when the backend restarts. Fine for developing the UI and API.
# To store requests in PostgreSQL, replace CHANGE-ME with your password:
DATABASE_URL=postgres://postgres:CHANGE-ME@localhost:5432/aamp
